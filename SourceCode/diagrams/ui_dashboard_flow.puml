@startuml ui_dashboard_flow
!theme plain
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam activity {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontSize 10
}
skinparam diamond {
    BackgroundColor #FFF8E1
    BorderColor #E65100
}

title Sơ đồ hoạt động: Tương tác người dùng với Dashboard thị trường

start

:Người dùng truy cập\nMarket Dashboard (/dashboard);

:Khởi tạo bộ lọc mặc định\n(30 ngày · tất cả khu vực · tất cả loại việc);

fork
    :GET /dashboard/filter-options;
    :Hiển thị ba bộ lọc\n(khu vực · thời gian · loại việc);
fork again
    :Gọi đồng thời sáu API\nqua Promise.all;
    :Nhận stats · trends · industries · hot-jobs\n· in-demand skills · rising skills;
    :Cập nhật state và kết xuất\n3 thẻ chỉ số, AreaChart, Treemap,\nHot Jobs và hai lưới kỹ năng;
end fork

if (Người dùng thay đổi bộ lọc?) then (Có)
    :Cập nhật tham số lọc;
    :Gọi lại sáu API và render lại Dashboard;
else (Không)
endif

if (Nhấn thẻ chỉ số?) then (Có)
    :Điều hướng /jobs\nkèm bộ lọc tương ứng;
else (Không)
    if (Nhấn một Hot Job?) then (Có)
        :Điều hướng /jobs\nkèm search_group và bộ lọc hiện tại;
    else (Không)
        :Tiếp tục xem dữ liệu thị trường;
    endif
endif

stop

@enduml
