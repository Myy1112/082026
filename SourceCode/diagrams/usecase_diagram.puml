@startuml usecase_diagram
!theme plain
left to right direction
skinparam defaultFontSize 12
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EEF2FF
    BorderColor #3F51B5
    FontSize 12
}
skinparam package {
    BackgroundColor #FDFDFD
    BorderColor #999999
}

title Sơ đồ Use Case tổng quát — Hệ thống CareerNova

actor "Sinh viên" as SV
actor "Hệ thống ETL\n(Tự động)" as ETL

rectangle "CareerNova System" {
    package "Quản lý tài khoản" as P1 {
        usecase "UC-01: Đăng ký" as UC01
        usecase "UC-02: Đăng nhập" as UC02
        usecase "UC-03: Xác thực email" as UC03
        usecase "UC-05: Onboarding" as UC05
        usecase "UC-06: Cập nhật hồ sơ" as UC06
        usecase "UC-07: Cài đặt tài khoản" as UC07
    }

    package "Khám phá việc làm" as P2 {
        usecase "UC-12: Tìm việc làm" as UC12
        usecase "UC-13: Xem JD chi tiết" as UC13
        usecase "UC-14: Lưu việc làm" as UC14
        usecase "UC-15: Đề xuất việc làm" as UC15
        usecase "UC-18: Lộ trình học" as UC18
    }

    package "Quản lý CV & So khớp" as P3 {
        usecase "UC-08: Quản lý CV" as UC08
        usecase "UC-09: So khớp CV với JD" as UC09
        usecase "UC-10: Biểu đồ Radar" as UC10
        usecase "UC-11: Gap Report" as UC11
    }

    package "Trực quan hóa" as P4 {
        usecase "UC-16: Dashboard thị trường" as UC16
        usecase "UC-17: Dashboard cá nhân" as UC17
    }

    package "Thu thập dữ liệu" as P5 {
        usecase "UC-21: Thu thập JD tự động" as UC21
        usecase "UC-22: Chuẩn hóa dữ liệu" as UC22
    }
}

' Grouping packages to balance the layout horizontally
P1 -[hidden]down-> P3
P3 -[hidden]down-> P4

P2 -[hidden]down-> P5

' Connections
SV --> UC01
SV --> UC02
SV --> UC05
SV --> UC06
SV --> UC07
SV --> UC08
SV --> UC09
SV --> UC12
SV --> UC13
SV --> UC14
SV --> UC15
SV --> UC16
SV --> UC17
SV --> UC18

ETL --> UC21

UC01 .> UC03 : <<include>>
UC09 .> UC10 : <<include>>
UC09 .> UC11 : <<include>>
UC11 .> UC18  : <<extend>>
UC17 .> UC10  : <<extend>>
UC21 .> UC22 : <<include>>

@enduml
