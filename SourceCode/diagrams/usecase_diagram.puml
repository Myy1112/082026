@startuml usecase_diagram
!theme plain
left to right direction
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor #EEF2FF
    BorderColor #3F51B5
    FontSize 10
}

title Sơ đồ ca sử dụng tổng quát — Hệ thống CareerNova

actor "Sinh viên" as SV
actor "Admin" as ADMIN
actor "Hệ thống ETL\n(Tự động)" as ETL

rectangle "CareerNova System" {

    package "Quản lý tài khoản" {
        usecase "UC-01\nĐăng ký tài khoản" as UC01
        usecase "UC-02\nĐăng nhập\n(Email / Google OAuth)" as UC02
        usecase "UC-03\nXác thực email" as UC03
        usecase "UC-05\nOnboarding" as UC05
        usecase "UC-06\nCập nhật hồ sơ" as UC06
        usecase "UC-07\nCài đặt tài khoản" as UC07
    }

    package "Quản lý CV và So khớp" {
        usecase "UC-08\nTải lên / quản lý CV" as UC08
        usecase "UC-09\nSo khớp CV với\ntin tuyển dụng" as UC09
        usecase "UC-10\nXem biểu đồ Radar\nkỹ năng" as UC10
        usecase "UC-11\nXem Gap Report" as UC11
    }

    package "Khám phá việc làm" {
        usecase "UC-12\nTìm kiếm việc làm" as UC12
        usecase "UC-13\nXem chi tiết JD" as UC13
        usecase "UC-14\nLưu việc làm\nyêu thích" as UC14
        usecase "UC-15\nXem đề xuất\nviệc làm" as UC15
        usecase "UC-18\nXem lộ trình\nhọc tập" as UC18
    }

    package "Trực quan hóa & Phân tích" {
        usecase "UC-16\nXem Dashboard\nthị trường" as UC16
        usecase "UC-17\nXem Dashboard\ncá nhân" as UC17
    }

    package "Quản trị hệ thống" {
        usecase "UC-19\nQuản lý người dùng" as UC19
        usecase "UC-20\nXem báo cáo\nhệ thống" as UC20
    }

    package "Thu thập dữ liệu (tự động)" {
        usecase "UC-21\nThu thập JD\ntự động" as UC21
        usecase "UC-22\nChuẩn hóa và\nnạp vào PostgreSQL" as UC22
    }
}

' Sinh viên
SV --> UC01
SV --> UC02
SV --> UC05
SV --> UC06
SV --> UC07
SV --> UC08
SV --> UC09
SV --> UC12
SV --> UC13
SV --> UC14
SV --> UC15
SV --> UC16
SV --> UC17
SV --> UC18

' include / extend
UC01 .right.> UC03 : <<include>>
UC09 .right.> UC10 : <<include>>
UC09 .right.> UC11 : <<include>>
UC11 .down.> UC18  : <<extend>>
UC17 .up.>   UC10  : <<extend>>

' Admin
ADMIN --> UC02
ADMIN --> UC19
ADMIN --> UC20

' ETL
ETL --> UC21
UC21 .right.> UC22 : <<include>>

@enduml
