@startuml dashboard_sequence
!theme plain
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipant underline
skinparam sequenceBoxBackgroundColor #F5F5F5

title Sơ đồ tuần tự: Xem Dashboard thống kê thị trường việc làm

actor       "Sinh viên"              as User
participant "Trình duyệt\n(Frontend)"       as FE
participant "Core API"               as API
database    "Cơ sở dữ liệu"          as DB

autonumber

User -> FE : Điều hướng đến\nMarket Dashboard
FE   -> FE : Khởi tạo giao diện\nvà yêu cầu dữ liệu

note over FE, API : Truy vấn song song (Promise.all)

par Truy vấn song song
    FE -> API : Yêu cầu Xu hướng tuyển dụng
else
    FE -> API : Yêu cầu Phân bổ ngành
else
    FE -> API : Yêu cầu Dải lương theo vị trí
end

group Xử lý Xu hướng tuyển dụng
    API -> DB   : Truy vấn lượng tin tuyển dụng\nvà việc làm từ xa theo thời gian
    DB --> API  : Dữ liệu thời gian thực
end

group Xử lý Phân bổ ngành
    API -> DB   : Đếm số tin theo từng ngành
    DB --> API  : Dữ liệu phân bổ
end

group Xử lý Dải lương
    API -> DB   : Tính trung bình lương (Min/Max)\nnhóm theo vị trí
    DB --> API  : Dữ liệu lương trung bình
end

API --> FE : Tập hợp toàn bộ kết quả\n(JSON)

FE -> FE : Xử lý dữ liệu và\ncập nhật trạng thái (State)

FE -> FE : Kết xuất biểu đồ\n(Xu hướng, Phân bổ, Dải lương)

FE --> User : Hiển thị Dashboard hoàn chỉnh
@enduml
