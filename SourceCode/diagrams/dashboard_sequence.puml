@startuml dashboard_sequence
!theme plain
skinparam defaultFontSize 10
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipant underline
skinparam sequenceBoxBackgroundColor #F5F5F5

title Sơ đồ tuần tự: Xem Dashboard thống kê thị trường việc làm

actor       "Người dùng"              as User
participant "Next.js\nFrontend"       as FE
participant "CareerNova\nBackend API\n(NestJS)" as API
database    "PostgreSQL"              as DB

User -> FE : Điều hướng đến\nMarket Dashboard
FE   -> FE : Khởi tạo component\nMarketDashboard.tsx\ngọi fetchDashboardData()

note over FE, API : Ba truy vấn được gửi song song — Promise.all()

par Truy vấn song song
    FE -> API : GET /market-dashboard/trends\n?scale=month (hoặc year)
and
    FE -> API : GET /market-dashboard/industry-breakdown
and
    FE -> API : GET /market-dashboard/salary-ranges
end

group Xử lý: Xu hướng tuyển dụng
    API -> DB   : SELECT period, SUM(total_postings),\nSUM(remote_jobs)\nFROM jobs GROUP BY period\nORDER BY period
    DB --> API  : [{date, total_postings, remote_jobs}]
    API --> FE  : TrendDataPointDto[]
end

group Xử lý: Phân bổ ngành công nghiệp
    API -> DB   : SELECT i.industry_name,\nCOUNT(j.job_id) AS count\nFROM jobs j JOIN industries i\nGROUP BY industry\nORDER BY count DESC
    DB --> API  : [{industry_name, count}]
    API --> FE  : IndustryItemDto[]
end

group Xử lý: Dải lương theo vị trí
    API -> DB   : SELECT j.title AS role,\nAVG(s.min_salary), AVG(s.max_salary)\nFROM jobs j JOIN salaries s\nGROUP BY role\nORDER BY max_salary DESC
    DB --> API  : [{role, min_salary, max_salary}]
    API --> FE  : SalaryRangeItemDto[]
end

FE -> FE : Cập nhật state:\nsetTrends()\nsetIndustriesData()\nsetSalaryRangesData()

FE -> FE : Kết xuất 3 biểu đồ\n(Recharts ResponsiveContainer)

FE --> User : AreaChart — Xu hướng tuyển dụng\nPieChart  — Phân bổ ngành\nBarChart  — Dải lương theo vị trí

@enduml
