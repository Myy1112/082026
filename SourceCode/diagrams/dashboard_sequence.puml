@startuml dashboard_sequence
!theme plain
skinparam defaultFontSize 11
skinparam defaultFontName Arial
skinparam backgroundColor #FFFFFF
skinparam sequenceArrowThickness 1.5
skinparam sequenceParticipant underline
skinparam sequenceBoxBackgroundColor #F5F5F5

title Sơ đồ tuần tự: Xem Dashboard thống kê thị trường việc làm

actor       "Sinh viên"              as User
participant "Trình duyệt\n(Frontend)"       as FE
participant "Core API"               as API
database    "Cơ sở dữ liệu"          as DB

autonumber

User -> FE : Điều hướng đến\nMarket Dashboard
FE   -> FE : Áp dụng bộ lọc\n(thời gian, khu vực, loại việc)

note over FE, API : Truy vấn song song (Promise.all)

par Truy vấn song song
    FE -> API : GET /dashboard/stats
else
    FE -> API : GET /dashboard/trends
else
    FE -> API : GET /dashboard/industries
else
    FE -> API : GET /dashboard/hot-jobs
else
    FE -> API : GET /dashboard/skills/in-demand
else
    FE -> API : GET /dashboard/skills/rising
end

group Xử lý dữ liệu Dashboard
    API -> DB   : Tổng hợp số liệu, xu hướng,\nnhóm kỹ năng, vị trí hot\nvà kỹ năng tăng trưởng
    DB --> API  : Sáu tập dữ liệu theo bộ lọc
end

API --> FE : Sáu phản hồi JSON

FE -> FE : Cập nhật State\nsetStats, setTrends, setIndustriesData,\nsetHotJobsData, setInDemandSkillsData,\nsetRisingSkillsData

FE -> FE : Kết xuất Stats Cards, AreaChart,\nTreemap và các BarChart

FE --> User : Hiển thị Dashboard hoàn chỉnh
@enduml
